# Rename to .env.cloud on the server. Never commit the real file.
MAILFLOW_DOMAIN=mailflow.example.com
DB_URL=jdbc:postgresql://db.example.com:5432/postgres?sslmode=verify-full&sslrootcert=/home/mailflow/.postgresql/root.crt
DB_USER=mailflow
DB_PASSWORD=generate-a-long-unique-database-password
DB_SSL_ROOT_CERT_BASE64=base64-encoded-postgresql-root-certificate
OWNER_EMAIL=owner@example.com
INITIAL_OWNER_SETUP_TOKEN=generate-a-long-single-use-token
# Generate with: openssl rand -base64 32
MAILFLOW_CREDENTIAL_KEY_V1=replace-with-a-base64-32-byte-key
# Optional only while rotating a key. Remove after all SMTP accounts have been opened once.
MAILFLOW_CREDENTIAL_KEY_V0=
APP_TIMEZONE=America/Sao_Paulo
